`timescale 1ns / 1ps
//////////////////////////////////////////////////////////////////////////////////
// Module Name: clk_divider
// Description: Divides clk by 2^WIDTH using a free-running counter; clk_d is the
//              counter MSB. With a 100 MHz clock and WIDTH = 17, clk_d is about
//              763 Hz, which gives each of the 4 digits a ~190 Hz refresh rate.
//////////////////////////////////////////////////////////////////////////////////

module clk_divider #(
    parameter WIDTH = 17
    )(
    input  clk,
    input  reset,
    output clk_d
    );

    reg [WIDTH-1:0] count;

    always @(posedge clk) begin
        if (reset)
            count <= {WIDTH{1'b0}};
        else
            count <= count + 1'b1;
    end

    assign clk_d = count[WIDTH-1];

endmodule
