`timescale 1ns / 1ps
//////////////////////////////////////////////////////////////////////////////////
// Module Name: seven_seg
// Description: Time-multiplexed 4-digit hex display driver. value[15:12] is the
//              leftmost digit. seg and an are active low (common-anode display,
//              e.g. Basys 3 / Nexys). seg = {g,f,e,d,c,b,a}. clk_d should be a
//              slow clock (see clk_divider).
//////////////////////////////////////////////////////////////////////////////////

module seven_seg(
    input         clk_d,
    input         reset,
    input  [15:0] value,
    output reg [6:0] seg,
    output reg [3:0] an
    );

    reg [1:0] sel;
    reg [3:0] digit;

    always @(posedge clk_d) begin
        if (reset)
            sel <= 2'b00;
        else
            sel <= sel + 1'b1;
    end

    // pick the active digit and enable its anode
    always @(*) begin
        case (sel)
            2'd0: begin digit = value[3:0];    an = 4'b1110; end
            2'd1: begin digit = value[7:4];    an = 4'b1101; end
            2'd2: begin digit = value[11:8];   an = 4'b1011; end
            default: begin digit = value[15:12]; an = 4'b0111; end
        endcase
    end

    // hex digit -> segments
    always @(*) begin
        case (digit)
            4'h0: seg = 7'b1000000;
            4'h1: seg = 7'b1111001;
            4'h2: seg = 7'b0100100;
            4'h3: seg = 7'b0110000;
            4'h4: seg = 7'b0011001;
            4'h5: seg = 7'b0010010;
            4'h6: seg = 7'b0000010;
            4'h7: seg = 7'b1111000;
            4'h8: seg = 7'b0000000;
            4'h9: seg = 7'b0010000;
            4'hA: seg = 7'b0001000;
            4'hB: seg = 7'b0000011;
            4'hC: seg = 7'b1000110;
            4'hD: seg = 7'b0100001;
            4'hE: seg = 7'b0000110;
            4'hF: seg = 7'b0001110;
            default: seg = 7'b1111111;
        endcase
    end

endmodule
